# Provider credentials (optional for the non-AI local profile). Set only those you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# AI model configuration. Values are provider:model. A task value overrides WHATS_A_CV_MODEL.
WHATS_A_CV_MODEL=openai:gpt-5.6-luna
WHATS_A_CV_REQUIREMENTS_MODEL=
WHATS_A_CV_EVIDENCE_MODEL=
WHATS_A_CV_CV_MODEL=
WHATS_A_CV_NEXT_STEPS_MODEL=

# Local service URLs.
WEB_URL=http://localhost:3000
AGENT_URL=http://localhost:8000
